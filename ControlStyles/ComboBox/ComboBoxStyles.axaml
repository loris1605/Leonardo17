<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ControlStyles">
  <Design.PreviewWith>
    <Border Padding="20">
      <local:UiComboBox/>
    </Border>
  </Design.PreviewWith>

    
  <Style Selector="local|UiComboBox">
    <Setter Property="Foreground" Value="#182535"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FontFamily" Value="Verdana"/>
    <Setter Property="FontSize" Value="18"/>
    <Setter Property="Padding" Value="6,4"/>
    <Setter Property="CornerRadius" Value="8"/>

    <Setter Property="Background" Value="#F4F7FA"/>
    <Setter Property="BorderBrush" Value="#8095A8B8"/>
    <Setter Property="BorderThickness" Value="1"/>

    <Setter Property="Template">
        <ControlTemplate TargetType="ComboBox">
            <Grid>
                <Border x:Name="PART_Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        BoxShadow="inset 0 1 2 0 #25000000">

                    <ContentPresenter
                        x:Name="PART_ContentPresenter"
                        Content="{TemplateBinding SelectionBoxItem}"
                        Foreground="{TemplateBinding Foreground}"
                        Margin="{TemplateBinding Padding}"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                </Border>

                <Popup x:Name="PART_Popup"
                       Placement="Bottom"
                       IsOpen="{TemplateBinding IsDropDownOpen}">

                    <Border Background="#FFF4F7FA"
                            BorderBrush="#8095A8B8"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="4"
                            BoxShadow="0 8 22 0 #50000000">

                        <ItemsPresenter/>
                    </Border>
                </Popup>
            </Grid>
        </ControlTemplate>
    </Setter>
</Style>

<Style Selector="local|UiComboBox ComboBoxItem">
    <Setter Property="Foreground" Value="#182535"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="10,7"/>
</Style>

<Style Selector="local|UiComboBox ComboBoxItem:pointerover">
    <Setter Property="Foreground" Value="#102030"/>
    <Setter Property="Background" Value="#D8E4EE"/>
</Style>

<Style Selector="local|UiComboBox ComboBoxItem:selected">
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="Background" Value="#526E88"/>
</Style>

  <!-- Add Styles Here -->
</Styles>
