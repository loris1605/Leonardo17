<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrls="using:Cassa.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lc="using:Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Cassa.ViewModels"
             xmlns:ui="using:ControlStyles"
             mc:Ignorable="d"
             xmlns:r="using:ReactiveUI.Avalonia"
             d:DesignWidth="800"
             d:DesignHeight="450"
             KeyboardNavigation.TabNavigation="Cycle"
             Background="LightSteelBlue"
             x:DataType="vm:CassaPostazioneViewModel"
             x:Class="Cassa.Views.CassaPostazioneView">

    <Grid x:Name="MainGrid" 
          HorizontalAlignment="Stretch" 
          VerticalAlignment="Stretch">
    
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- TITOLO -->
            <RowDefinition Height="100"/> <!-- PULSANTI -->
            <RowDefinition Height="*"/> <!-- GRID CENTRALE -->
            <RowDefinition Height="Auto"/> <!-- BARRA INFERIORE -->
            <RowDefinition Height="50"/> <!-- BARRA DI ERROR -->
        </Grid.RowDefinitions>  

        <lc:TitleView Grid.Row="0"
                      TitoloPagina="POSTAZIONE CASSA"
                      x:Name="Title"
                      ButtonText="Esci"
                      ToolTipText="TORNA A MENU PRINCIPALE"
                      ExitCommand="{Binding EscPressedCommand}"/>

        
        <ctrls:PulsantiPostazioneView
                Grid.Row="1"
                x:Name="PulsantiPostazione"
                Margin="0,10,0,10"/>
        
        
        
        
        <Grid x:Name="CentralGrid" 
              Grid.Row="2"
              IsVisible="{Binding IsOpen}">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <r:RoutedViewHost x:Name="RouterSchedaConto" 
                          Router="{Binding RouterSchedaConto}"
                          Grid.Column="1"
                          Grid.ColumnSpan="2"
                          IsVisible="{Binding IsOpen}">
                <r:RoutedViewHost.PageTransition>
                    <CrossFade Duration="0:0:0.5" />
                </r:RoutedViewHost.PageTransition>
                <r:RoutedViewHost.DefaultContent>
                    <Border/>
                </r:RoutedViewHost.DefaultContent>
            </r:RoutedViewHost>
            
        </Grid>

        <Grid Grid.Row="3" 
             ColumnDefinitions="*,*,Auto"
             Margin="80,20">
		   
            <ui:UiInfoBorder Grid.Column="2"
                             IsVisible="{Binding IsOpen}">
		        
                <StackPanel Orientation="Horizontal" 
                            Margin="20">
                         
                    <TextBlock Text="{Binding BindingT.Cognome, StringFormat='{}{0} '}" 
                       x:Name="CognomeTextBlock"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Foreground="Black" 
                       FontSize="16"/>
                 
                    <TextBlock Text="{Binding BindingT.Nome}" 
                               x:Name="NomeTextBlock"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="Black" 
                               FontSize="16"/>

                 </StackPanel>
           
           </ui:UiInfoBorder>

       </Grid>

        <TextBlock x:Name="ErrorLabel"
                    Grid.Row="4"
                    Grid.ColumnSpan="5"
                    FontSize="20"
                    Foreground="Red"
                    HorizontalAlignment="Center"
                    Margin="20,10"
                    Text="{Binding ErrorText}">

             <TextBlock.Styles>
                 <Style Selector="TextBlock">
                     <Style.Animations>
                         <Animation Duration="0:0:1"
                                    IterationCount="Infinite"
                                    PlaybackDirection="Alternate">
                             <KeyFrame KeyTime="0:0:0">
                                 <Setter Property="Opacity" Value="1.0"/>
                             </KeyFrame>
                             <KeyFrame KeyTime="0:0:1">
                                 <Setter Property="Opacity" Value="0.3"/>
                             </KeyFrame>
                         </Animation>
                     </Style.Animations>
                 </Style>
             </TextBlock.Styles>

        </TextBlock>      
    
    </Grid>


</UserControl>
